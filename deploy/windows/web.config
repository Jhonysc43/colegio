<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proxy reverso do IIS para o sistema, com HTTPS.
  Requisitos no IIS: modulos "URL Rewrite" e "Application Request Routing" (ARR),
  recurso "WebSocket Protocol" instalado, e ARR com "Enable proxy" marcado
  (IIS Manager > servidor > Application Request Routing Cache > Server Proxy Settings).
  Coloque este arquivo na pasta raiz do site HTTPS criado para o sistema.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />  <!-- o ARR repassa o WebSocket do Streamlit -->
    <rewrite>
      <rules>
        <rule name="ReceitaCNB" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8501/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />  <!-- 200 MB, igual ao maxUploadSize -->
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
